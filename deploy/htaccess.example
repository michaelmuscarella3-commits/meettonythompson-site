# Apache (cPanel) rules for a single-page app.
# Merge into public_html/.htaccess; keep any existing rules (e.g. HTTPS redirects).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Serve real files and folders (assets, api/*.php, PDFs) as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else goes to the React app.
  RewriteRule ^ index.html [L]
</IfModule>

# The live site's main script keeps the same name (index-CaJh229O.js) after
# every update, so tell browsers to check for a newer copy on each visit
# (unchanged files come back as a tiny "not modified" reply).
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|index-CaJh229O\.js(\.gz)?)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
